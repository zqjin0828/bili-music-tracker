{
  "manifest_version": 3,
  "name": "B站听歌追踪器",
  "version": "1.3.2",
  "description": "自动记录你在B站听过多少遍歌（支持中文/日语/英文曲目），可选接入 AI 提升判定准确率，达到阈值后提醒你收藏到「歌」收藏夹。v1.3：已在歌单里的歌不再重复计数；v1.3.1 新增每周索引全量重建、收藏夹容量显示与「歌」满后自动切换「歌2」续收，并修复收藏夹跳转页 404。v1.3.2 重做调试面板：直接标明「为什么不计数」（已收藏 / 非音乐 / 静音 / 索引降级 / 夹满等）。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/medialist/*"
      ],
      "js": [
        "src/parser.js",
        "src/detector.js",
        "src/fav-index.js",
        "src/ai.js",
        "src/hud.js",
        "src/content.js"
      ],
      "css": [
        "src/card.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "B站听歌追踪器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
