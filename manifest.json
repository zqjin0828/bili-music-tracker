{
  "manifest_version": 3,
  "name": "B站听歌追踪器",
  "version": "1.2.3",
  "description": "自动记录你在B站听过多少遍歌（支持中文/日语/英文曲目），可选接入 AI 提升判定准确率，达到阈值后提醒你收藏到「歌」收藏夹。v1.2.3 修复分区信号失效（内容脚本读不到页面状态）。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/medialist/*"
      ],
      "js": [
        "src/parser.js",
        "src/detector.js",
        "src/ai.js",
        "src/content.js"
      ],
      "css": [
        "src/card.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "B站听歌追踪器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/inject.js"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ]
    }
  ]
}
